{
  "manifest_version": 3,
  "name": "Farm RPG Calculator Account Sync",
  "version": "1.11.2",
  "description": "Read-only sync from visited Farm RPG pages to Farm RPG Calculator, on your computer or its website.",
  "permissions": [
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://farmrpg.com/*",
    "https://www.farmrpg.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://alikdash1.github.io/Farmrpgcalculator/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Farm RPG Calculator Account Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://farmrpg.com/*",
        "https://www.farmrpg.com/*"
      ],
      "js": [
        "capture-page.js",
        "farm-content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "file:///*",
        "https://alikdash1.github.io/Farmrpgcalculator/*"
      ],
      "js": [
        "calculator-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
