{
  "manifest_version": 3,
  "name": "Lantern Ledger Account Sync",
  "version": "1.2.0",
  "description": "Read-only local sync from visited Farm RPG pages to Lantern Ledger.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://farmrpg.com/*", "https://www.farmrpg.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Lantern Ledger Account Sync", "default_popup": "popup.html" },
  "content_scripts": [
    {"matches": ["https://farmrpg.com/*", "https://www.farmrpg.com/*"], "js": ["capture-page.js", "farm-content.js"], "css": ["panel.css"], "run_at": "document_idle"},
    {"matches": ["http://127.0.0.1/*", "http://localhost/*", "file:///*"], "js": ["calculator-bridge.js"], "run_at": "document_idle"}
  ]
}
